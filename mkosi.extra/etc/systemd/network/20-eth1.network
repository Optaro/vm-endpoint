[Match]
Name=eth1

[Link]
RequiredForOnline=no

[Network]
# eth1 is the 802.1Q trunk to the customer's switch. The VM Image agent creates
# tagged sub-interfaces (eth1.<vid>) and bridges them with VXLANs riding
# over wg0 — networkd is intentionally not asked to assign an IP here.
LinkLocalAddressing=no
LLDP=no
EmitLLDP=no
